
	<Grid Margin="0,0,0,0"  Background="White" ShowGridLines="false">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />			
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="*"/>			
		</Grid.ColumnDefinitions>
		
		
		<Ribbon Name="ribCodeSign"  Grid.Row="0" Grid.RowSpan="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,10,10,0" SelectedIndex="0" >
			<Ribbon.Background>
				<ImageBrush/>
			</Ribbon.Background>
			
			<!-- Application Menu, located at the left-hand side (down arrow) -->
			<Ribbon.ApplicationMenu>
				<RibbonApplicationMenu>                
					<RibbonApplicationMenuItem Name="rAppMenuExit"   Header="Exit" />
					<RibbonApplicationMenuItem Name="rAppMenuSearch" Header="Search" />
				</RibbonApplicationMenu>
			</Ribbon.ApplicationMenu>
        <!-- Ribbon Tab #1: Home -->
			
		<!-- TAB START--> 			
			<RibbonTab Header="Start">
            
				<RibbonGroup Name="rtabClose"  Header="Exit">
					<RibbonButton Name="rbtnExit" Label="Exit" IsCancel="True"/>
				</RibbonGroup>
				
				<RibbonGroup Name="rtabSSC" Header="Self-signed certificate">
					<RibbonButton Name="rbtnListSSC"   Label="List" IsDefault="True" ToolTip="List self-signed certificates"/>
					<RibbonButton Name="rbtnNewSSC"    Label="Create" ToolTip="Create a new self-signed certificate"/>
					<RibbonButton Name="rbtnRemoveSSC" Label="Remove" ToolTip="Remove a self-signed certificate"/>
				</RibbonGroup>
				
				<RibbonGroup Name="rtabFilter" Header="PowerShell script signing">
					<RibbonButton Name="rbtnStartSigning" Label="Signing" ToolTip="Start code signing"/>
					<RibbonButton Name="rbtnTestSigning"  Label="Test" ToolTip="Test code signing"/>							
				</RibbonGroup>
				
				
			</RibbonTab>
		</Ribbon>
				
		<GroupBox Name="groupboxParamSelfSign" Grid.Row="1" Grid.RowSpan="1" Grid.Column="0" Margin="10,10,10,10" BorderThickness="2" >
			<GroupBox.Header>Self-signed certificate</GroupBox.Header>
			<Grid>
				<Grid.RowDefinitions>					
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />									
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>					
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />					
				</Grid.ColumnDefinitions>
								
				<Label    Name="lblDnsName" Grid.Row="0" Grid.Column="0" Margin="5,10,0,0" Content="DNS-Name" />
                <TextBox  Name="txtDnsName" Grid.Row="0" Grid.Column="1" Margin="0,10,10,0"  />
				
				<Label    Name="lblFriendlyName" Grid.Row="1" Grid.Column="0" Margin="5,10,0,0" Content="Friendly name" />
                <TextBox  Name="txtFriendlyName" Grid.Row="1" Grid.Column="1" Margin="0,10,10,0"  />
				
				<Label    Name="lblKeyLength" Grid.Row="2" Grid.Column="0" Margin="5,10,0,0" Content="Key length" />
				<ComboBox Name="cboKeyLength" Grid.Row="2" Grid.Column="1" Margin="0,10,10,0" />
				
				<Label    Name="lblHashAlgo" Grid.Row="3" Grid.Column="0" Margin="5,10,0,0" Content="Hash algorithm" />
				<ComboBox Name="cboHashAlgo" Grid.Row="3" Grid.Column="1" Margin="0,10,10,0" />
				
				<Label   Name="lblValidYears" Grid.Row="4" Grid.Column="0" Margin="5,10,0,0" Content="Valid years" />
				<TextBox Name="txtValidYears" Grid.Row="4" Grid.Column="1" Margin="0,10,10,0" />
				
				<Label Name="lblCAStore"  Grid.Row="5" Grid.Column="0" Margin="5,10,0,0" Content="Cert store" />
				<Label Name="lblCAStore2" Grid.Row="5" Grid.Column="1" Margin="0,10,10,0" Content="CurrentUser => My"/>
			</Grid>
		</GroupBox>	
		
		<GroupBox Name="groupboxListSelfSign" Grid.Row="2" Grid.RowSpan="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,10,10,10" BorderThickness="2" >
			<GroupBox.Header>List code signing certfificates</GroupBox.Header>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />									
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />					
				</Grid.ColumnDefinitions>
				
				<DataGrid Name="dgCodSelfSign"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Margin="10,10,10,10" />
				
			</Grid>
		</GroupBox>
		
		<GroupBox Grid.Row="1" Grid.RowSpan="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,10,10,10" BorderThickness="2" >
			<GroupBox.Header>Test PowerShell Signature</GroupBox.Header>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />					
					<RowDefinition Height="*" />									
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				
				<Label    Name="lblAuthSigPath" Grid.Row="0" Grid.Column="0" Margin="5,10,0,0" Content="Path" />
                <TextBox  Name="txtAuthSigPath" Grid.Row="0" Grid.Column="1" Margin="0,10,10,0"  />
				
				<Label    Name="lblAuthSigStatus" Grid.Row="1" Grid.Column="0" Margin="5,10,0,0" Content="Status" />
                <TextBox  Name="txtAuthSigStatus" Grid.Row="1" Grid.Column="1" Margin="0,10,10,0"  />
				
				<Label    Name="lblAuthSigStatusMsg" Grid.Row="2" Grid.Column="0" Margin="5,10,0,0" Content="Status message" />
				<TextBox  Name="txtAuthSigStatusMsg" Grid.Row="2" Grid.Column="1" Margin="0,10,10,0"  />
				
				<Label    Name="lblAuthSigType" Grid.Row="3" Grid.Column="0" Margin="5,10,0,0" Content="Signature type" />
				<TextBox  Name="txtAuthSigType" Grid.Row="3" Grid.Column="1" Margin="0,10,10,0"  />
				
				<Label    Name="lblAuthSigTimeStamp" Grid.Row="4" Grid.Column="0" Margin="5,10,0,0" Content="Timestamp Server" />
				<TextBox  Name="txtAuthSigTimeStamp" Grid.Row="4" Grid.Column="1" Margin="0,10,10,0"  />
				
				<Label   Name="lblAuthSigThumbprint" Grid.Row="5" Grid.Column="0" Margin="5,10,0,0" Content="Thumbprint" />
				<TextBox Name="txtAuthSigThumbprint" Grid.Row="5" Grid.Column="1" Margin="0,10,10,0" />
				
				<Label 	 Name="lblAuthSigNotAfter" Grid.Row="6" Grid.Column="0" Margin="5,10,0,0" Content="Not After" />
				<TextBox Name="txtAuthSigNotAfter" Grid.Row="6" Grid.Column="1" Margin="0,10,10,0" />				
				
			</Grid>
		</GroupBox>
		
        <StatusBar Name="staInfo" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,10,10" Height="50" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
			<Grid>
				<Grid.RowDefinitions>					
					<RowDefinition Height="Auto" />									
				</Grid.RowDefinitions>
				
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />					                       
				</Grid.ColumnDefinitions>			
               
				<StatusBarItem Grid.Row="0" Grid.Column="0" >
					<TextBox Name="txtStatusInfo" FontSize="18" Background="Transparent" BorderThickness="0" />
				</StatusBarItem>
				
			</Grid>
        </StatusBar>
		
		
	</Grid>

 